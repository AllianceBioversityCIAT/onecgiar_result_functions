{
  "$id": "https://prms/schemas/innovation_use.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Innovation Use Result",
  "description": "Schema for innovation use results",
  "allOf": [
    { "$ref": "https://prms/schemas/common_fields.json" },
    {
      "type": "object",
      "properties": {
        "innovation_use": {
          "type": "object",
          "properties": {
            "innovation_use_level": {
              "type": "object",
              "description": "Stage of use being claimed. Required for every innovation use, including one whose numbers are yet to be determined. Provide 'level' if you hold the PRMS code, 'name' if you only have the label.",
              "properties": {
                "level": {
                  "description": "PRMS code for the innovation use level.",
                  "oneOf": [{ "type": "integer" }, { "type": "string" }]
                },
                "name": {
                  "type": "string",
                  "description": "Label of the innovation use level, matched by name."
                }
              },
              "additionalProperties": false,
              "anyOf": [{ "required": ["level"] }, { "required": ["name"] }]
            },
            "current_innovation_use_numbers": {
              "type": "object",
              "properties": {
                "innov_use_to_be_determined": {
                  "type": "boolean",
                  "description": "If true, no actors data is required"
                },
                "actors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "result_actors_id": {
                        "oneOf": [{ "type": "string" }, { "type": "integer" }]
                      },
                      "actor_type_id": {
                        "oneOf": [{ "type": "string" }, { "type": "integer" }]
                      },
                      "actor_type_name": { "type": "string" },
                      "other_actor_type": { "type": ["string", "null"] },
                      "sex_and_age_disaggregation": {
                        "type": ["boolean", "null"]
                      },
                      "how_many": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "women": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "women_youth": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "men": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "men_youth": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "previousWomen": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      }
                    },
                    "anyOf": [
                      { "required": ["actor_type_id"] },
                      { "required": ["actor_type_name"] }
                    ],
                    "allOf": [
                      {
                        "if": {
                          "required": ["sex_and_age_disaggregation"],
                          "properties": {
                            "sex_and_age_disaggregation": { "const": true }
                          }
                        },
                        "then": {
                          "required": ["how_many"]
                        }
                      },
                      {
                        "if": {
                          "required": ["actor_type_id"],
                          "properties": {
                            "actor_type_id": { "enum": ["5", 5] }
                          }
                        },
                        "then": {
                          "required": ["other_actor_type"]
                        }
                      }
                    ]
                  }
                },
                "organization": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "institution_types_id": {
                        "oneOf": [{ "type": "string" }, { "type": "integer" }]
                      },
                      "institution_types_name": { "type": "string" },
                      "institution_sub_type_id": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "institution_sub_type_name": { "type": "string" },
                      "other_institution": { "type": ["string", "null"] },
                      "how_many": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "integer" },
                          { "type": "null" }
                        ]
                      },
                      "hide": { "type": "boolean" }
                    },
                    "anyOf": [
                      { "required": ["institution_types_id"] },
                      { "required": ["institution_types_name"] }
                    ],
                    "allOf": [
                      {
                        "if": {
                          "required": ["institution_types_id"],
                          "properties": {
                            "institution_types_id": { "enum": ["78", 78] }
                          }
                        },
                        "then": {
                          "required": ["other_institution"]
                        }
                      }
                    ]
                  }
                },
                "measures": {
                  "type": "array",
                  "description": "What the innovation use is counted in. At least one measure must carry both a 'unit_of_measure' and a numeric 'quantity'; a quantity of 0 is a valid answer.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "unit_of_measure": {
                        "type": "string",
                        "description": "Unit the quantity is expressed in, e.g. '# of Innovations' or 'Hectares'."
                      },
                      "quantity": {
                        "description": "How much of that unit. Explicitly 0 is accepted; blank or absent is not.",
                        "$comment": "Not oneOf [string, integer, number]: a whole number matches both 'integer' and 'number', so every integer quantity failed as 'must match exactly one schema in oneOf'. 'number' already covers integers.",
                        "type": ["string", "number"]
                      }
                    }
                  }
                }
              },
              "required": ["innov_use_to_be_determined"]
            }
          },
          "required": ["current_innovation_use_numbers"]
        }
      },
      "required": ["innovation_use"]
    }
  ]
}
